class Solution(object):
    def myAtoi(self, s):
        """
        :type s: str
        :rtype: int
        """
        # Step 1: Initialize variables
        i = 0
        n = len(s)
        sign = 1
        result = 0
        
        # 32-bit signed integer boundaries
        INT_MIN = -2**31
        INT_MAX = 2**31 - 1

        # Step 2: Skip leading whitespace
        while i < n and s[i] == ' ':
            i += 1

        # Step 3: Check for sign
        if i < n:
            if s[i] == '-':
                sign = -1
                i += 1
            elif s[i] == '+':
                i += 1

        # Step 4: Convert digits and handle clamping
        while i < n and s[i].isdigit():
            digit = int(s[i])
            
            # Check for overflow before appending the digit
            if result > (INT_MAX - digit) // 10:
                return INT_MAX if sign == 1 else INT_MIN
                
            result = result * 10 + digit
            i += 1

        # Step 5: Return final signed result
        return sign * result
