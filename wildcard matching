class Solution(object):
    def isMatch(self, s, p):
        """
        :type s: str
        :type p: str
        :rtype: bool
        """
        s_idx, p_idx = 0, 0
        match_idx = 0
        star_idx = -1
        
        s_len, p_len = len(s), len(p)
        
        while s_idx < s_len:
            # Case 1: Characters match, or pattern has '?'
            if p_idx < p_len and (p[p_idx] == s[s_idx] or p[p_idx] == '?'):
                s_idx += 1
                p_idx += 1
            # Case 2: Pattern has '*' -> Record position and try matching 0 characters first
            elif p_idx < p_len and p[p_idx] == '*':
                star_idx = p_idx
                match_idx = s_idx
                p_idx += 1
            # Case 3: Mismatch, but a previous '*' was encountered -> Backtrack
            elif star_idx != -1:
                p_idx = star_idx + 1
                match_idx += 1
                s_idx = match_idx
            # Case 4: Mismatch and no previous '*'
            else:
                return False
                
        # Check for remaining trailing stars in the pattern
        while p_idx < p_len and p[p_idx] == '*':
            p_idx += 1
            
        return p_idx == p_len
